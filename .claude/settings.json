{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just fmt)",
      "Bash(just lint)",
      "Bash(just test)",
      "Bash(just check)",
      "Bash(just verify)",
      "Bash(just build)",
      "Bash(just smoke)",
      "Bash(just docs-check)",
      "Bash(just install)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv build)",
      "Bash(uv run copilot-daily:*)",
      "Bash(uv run copilot-verify-analysis:*)",
      "Bash(uv run copilot-ingest-analysis:*)",
      "Bash(uv run copilot-history:*)",
      "Bash(uv run copilot-export-slices:*)",
      "Bash(./scripts/timebox.sh:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Edit(secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_check.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "tomada-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "tomada1114/tomada-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "tomada-kit@tomada-claude-plugins": true
  }
}
