# Copy this file to .env and fill in the values for the features you enable.
# .env itself is gitignored and must never be committed.

# Finnhub API (required for news collection)
FINNHUB_API_KEY=

# FRED API (required for the economic calendar)
FRED_API_KEY=

# Discord Webhook URL (optional; only needed if notification.enabled=true)
DISCORD_WEBHOOK_URL=

# SEC EDGAR requires a declared identity: "Your Name your@email.com"
EDGAR_IDENTITY=

# EODHD API key (unused until P4 production data provider)
EODHD_API_KEY=
